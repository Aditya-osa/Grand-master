# ======================================================================
# Grand Master - Production cPanel / Apache Configuration
# Target: https://www.grandmasters.co/new/
# Directory: public_html/new/
# ======================================================================

# ----------------------------------------------------------------------
# 1. Directory Slash & Canonical Subfolder URL
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /new/

  # Ensure access to /new redirects to /new/ with trailing slash
  RewriteCond %{REQUEST_URI} ^/new$
  RewriteRule ^(.*)$ /new/ [R=301,L]
</IfModule>

# ----------------------------------------------------------------------
# 2. CORS Headers for Static Assets & Web Fonts
# Prevents cross-origin / cross-subdomain blocks (e.g. www vs non-www)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js|mjs|svg|png|jpg|jpeg|gif|webp|ico|mp4|mov)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept"
  </FilesMatch>

  # Prevent browser from caching index.html so updates appear immediately
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>

  # Cache static hashed assets for 1 year
  <FilesMatch "\.(css|js|woff2|woff|ttf|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# 3. Correct MIME Types
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddType font/woff2 woff2
  AddType font/woff woff
  AddType font/ttf ttf
  AddType font/otf otf
  AddType image/webp webp
  AddType video/mp4 mp4
  AddType video/quicktime mov
</IfModule>

# ----------------------------------------------------------------------
# 4. Gzip / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 5. SPA Client-Side Routing
# Reroutes all unmatched routes to /new/index.html
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /new/

  # If requested path is an existing file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise fallback to index.html for Single Page Application routing
  RewriteRule ^ index.html [L]
</IfModule>
